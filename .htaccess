# Cartão virtual — Tatiane Cavalcanti (HostGator / Apache)

Options -Indexes
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddDefaultCharset utf-8

# --- HTTPS ---------------------------------------------------------------
# Descomentar SÓ depois que o AutoSSL do cPanel emitir o certificado do domínio final.
# A condição de host evita loop/erro na URL temporária da HostGator (que não tem certificado).
# TODO:DOMAIN — trocar DOMINIO pelo domínio final (ex.: tatiugc\.com\.br)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP_HOST} ^(www\.)?DOMINIO$ [NC]
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- compressão ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- cache ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- headers -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
